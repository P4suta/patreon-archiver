# Anything we never want baked into the image.

# VCS / editor
.git/
.jj/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets / runtime state
.env
.env.*
!.env.example
secrets/
downloads/
urls/urls.txt

# Compose / orchestration / docs not needed at runtime
compose.yaml
compose.override.yaml
compose.*.yaml
justfile
.pre-commit-config.yaml
.editorconfig
.yamllint.yaml
.hadolint.yaml
README.md
LICENSE

# Python caches
__pycache__/
*.py[cod]
.venv/
.uv-cache/
