# Anything we never want baked into the image.

# VCS / editor
.git/
.jj/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets / runtime state
.env
.env.*
!.env.example
secrets/
downloads/
urls/urls.txt

# Docs / dev configs not needed at runtime. justfile IS now baked in
# (it's the in-container dispatcher for `pa`), so it's intentionally
# absent from this ignore list.
.editorconfig
.yamllint.yaml
.hadolint.yaml
README.md
LICENSE
pa
tests/
lefthook.yml
typos.toml
renovate.json
.coverage
.coverage.*
coverage.xml
.hypothesis/
.pytest_cache/
.ruff_cache/

# Python caches
__pycache__/
*.py[cod]
.venv/
.uv-cache/
