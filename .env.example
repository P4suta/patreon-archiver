# Copy this file to .env and edit locally. .env is git-ignored.

# Where downloaded files end up on the HOST. Switch this to your external
# SSD mount when ready (no image rebuild required). Relative paths are
# resolved against the project root.
DOWNLOAD_DIR=./downloads

# Where state lives on the HOST: seen_posts.txt + coverage.txt + the
# scratch urls.txt that `pa sync` writes between inventory and batch.
STATE_DIR=./urls

# Path to a Netscape-format cookies file on the HOST. Optional — pa
# auto-detects and mounts it read-only if present.
COOKIES_FILE=./secrets/cookies.txt

TZ=Asia/Tokyo

# Inter-video sleep for `pa batch` / `pa sync`. Each video waits a random
# duration in [MIN, MAX] seconds before starting. Larger values = gentler
# on the creator's origin server, longer total batch time. Single-URL
# `pa download` is unaffected.
YTDLP_BATCH_SLEEP_MIN=5
YTDLP_BATCH_SLEEP_MAX=15
