# Copy this file to .env and edit locally. .env is git-ignored.

# Where downloaded files end up on the HOST. Switch this to your external
# SSD mount when ready (no image rebuild required). Relative paths are
# resolved against the project root.
DOWNLOAD_DIR=./downloads

# Path to a Netscape-format cookies file on the HOST. Only used by the
# `cookies` compose profile (i.e. `just download-cookies`).
COOKIES_FILE=./secrets/cookies.txt

# Match container UID/GID to the host user so bind-mounted files stay
# editable from the host. On WSL2 these usually default to 1000:1000.
UID=1000
GID=1000

TZ=Asia/Tokyo

# Inter-video sleep for `just batch`. Each video waits a random duration
# in [MIN, MAX] seconds before starting. Larger values = gentler on the
# creator's origin server, longer total batch time. Single-URL `just
# download` is unaffected.
YTDLP_BATCH_SLEEP_MIN=5
YTDLP_BATCH_SLEEP_MAX=15
