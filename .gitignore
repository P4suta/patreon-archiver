# All user-facing data lives under data/. Keep the directory tracked
# (via .gitkeep) so a fresh clone has a place to bind-mount, but ignore
# everything that ends up inside it.
data/*
!data/.gitkeep

# Local env overrides.
.env
.env.*

# uv / Python caches
.uv-cache/
__pycache__/
*.py[cod]
.venv/

# Test artefacts
.coverage
.coverage.*
coverage.xml
.hypothesis/
.pytest_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local dev session logs / state backups (the runtime keeps state
# inside data/; this dir is purely for ad-hoc captures while iterating
# on the wrapper).
logs/
