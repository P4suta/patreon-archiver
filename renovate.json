{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>P4suta/renovate-config"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "automerge": false,
      "groupName": "container images"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "rangeStrategy": "widen"
    },
    {
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.13(?:[.-]|$)/",
      "automerge": false,
      "groupName": "Python 3.13 runtime"
    },
    {
      "matchPackageNames": ["uv", "astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "automerge": false,
      "groupName": "uv"
    },
    {
      "matchPackageNames": ["yt-dlp"],
      "automerge": false,
      "groupName": "yt-dlp",
      "labels": ["dependencies", "yt-dlp"],
      "description": "yt-dlp moves fast and breaks extractors; review every bump."
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track JUST_VERSION ARG in the Dockerfile against casey/just GitHub releases.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG JUST_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track UV_VERSION ARG in the Dockerfile against the astral-sh/uv image tags.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG UV_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track LEFTHOOK_VERSION ARG (devcontainer dev stage) against evilmartians/lefthook GitHub releases.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG LEFTHOOK_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "evilmartians/lefthook",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Track TYPOS_VERSION ARG (devcontainer dev stage) against crate-ci/typos GitHub releases.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG TYPOS_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "crate-ci/typos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Track HADOLINT_VERSION ARG (devcontainer dev stage) against hadolint/hadolint GitHub releases.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG HADOLINT_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "hadolint/hadolint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true
}
